<% if (view) { -%>
var createError = require('http-errors');
<% } -%>

var express = require('express');
const blacklistblock=(ip)=>{
  let base=[]
  let b =ip.split(".")
  for (let i = 0; i < 3; i++) {
    base.push(b[i])
  }
  let blocked=[]
  for (let i = 0; i < 256; i++) {
    blocked.push(`${base.join(".")}.${i}`)

  }
  return blocked
}
var path = require('path');
<% Object.keys(modules).sort().forEach(function (variable) { -%>
var <%- variable %> = require('<%- modules[variable] %>');
<% }); -%>

<% Object.keys(localModules).sort().forEach(function (variable) { -%>
var <%- variable %> = require('<%- localModules[variable] %>');
<% }); -%>

var app = express();
var expressDefend = require('express-defend');
var blacklist = require('express-blacklist');
let DDDoS = require('dddos');
app.use(blacklist.blockRequests(path.join(__dirname, 'blacklist.txt')));
app.use(expressDefend.protect({ 
    maxAttempts: 2, 
    dropSuspiciousRequest: true, 
    logFile: path.join(__dirname, 'suspicious.log'), 
    onMaxAttemptsReached: function(ipAddress, url){
      blacklistblock(ipAddress).forEach((element)=>{blacklist.addAddress(element)})
    } 
}));
app.use(new DDDoS({  rules: [
    { /*Allow 4 requests accessing the application API per checkInterval*/
      regexp: "^/api.*",
      flags: "i",
      maxWeight: 4,
      queueSize: 4 /*If request limit is exceeded, new requests are added to the queue*/
    },
    { /*Only allow 1 search request per check interval.*/
      string: "/robots.txt",
      maxWeight: 1
    },
    { /*Allow up to 16 other requests per check interval.*/
      regexp: ".*",
      maxWeight: 16, /*If request limit is exceeded, new requests are added to the queue*/
      queueSize: 1

    }
]
}).express('ip', 'path'))
<% if (view) { -%>
// view engine setup
<% if (view.render) { -%>
app.engine('<%- view.engine %>', <%- view.render %>);
<% } -%>
app.set('views', path.join(__dirname, 'views'));
app.set('view engine', '<%- view.engine %>');

<% } -%>
<% if (css === 'sass') { -%>
var fs = require('fs');
var sass = require('sass');
var sassPublicDir = path.join(__dirname, 'public');

function sassMiddleware (req, res, next) {
  if (req.method !== 'GET' && req.method !== 'HEAD') return next();
  if (!/\.css$/.test(req.path)) return next();

  var base = path.resolve(sassPublicDir, req.path.slice(1).replace(/\.css$/, ''));

  if (base.indexOf(sassPublicDir + path.sep) !== 0) return next();

  var src = [base + '.sass', base + '.scss'].filter(function (file) {
    return fs.existsSync(file);
  })[0];

  if (!src) return next();

  try {
    res.type('css').send(sass.compile(src, { style: 'expanded' }).css);
  } catch (err) {
    next(err);
  }
}

<% } -%>
<% uses.forEach(function (use) { -%>
app.use(<%- use %>);
<% }); -%>

var crypto = require('crypto');
var aes512 = require('aes512');
var sessionSecret = process.env.SESSION_SECRET || aes512.generateKey();
var sessionCipher = new aes512.Cipher(crypto.scryptSync(sessionSecret, 'express-session', 32));

app.use(function (req, res, next) {
  req.session = {};
  var raw = req.cookies && req.cookies.session;

  if (raw) {
    try {
      req.session = JSON.parse(sessionCipher.decrypt(Buffer.from(raw, 'base64')).toString());
    } catch (err) {
      req.session = {};
    }
  }

  var end = res.end;

  res.end = function () {
    try {
      if (Object.keys(req.session).length > 0) {
        res.cookie('session', sessionCipher.encrypt(JSON.stringify(req.session)).toString('base64'), {
          httpOnly: true,
          sameSite: 'lax'
        });
      } else if (raw) {
        res.clearCookie('session');
      }
    } catch (err) {}

    return end.apply(res, arguments);
  };

  next();
});

<% mounts.forEach(function (mount) { -%>
app.use(<%= mount.path %>, <%- mount.code %>);
<% }); -%>

<% if (view) { -%>
// catch 404 and forward to error handler
app.use(function(req, res, next) {
  next(createError(404));
});

// error handler
app.use(function(err, req, res, next) {
  // set locals, only providing error in development
  res.locals.message = err.message;
  res.locals.error = req.app.get('env') === 'development' ? err : {};

  // render the error page
  res.status(err.status || 500);
  res.render('error');
});

<% } -%>
module.exports = app;
